# Destructive operations are blocked.
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is prohibited; remove only an explicitly verified target.",
    match = ["rm -rf temp"],
)

prefix_rule(
    pattern = ["Remove-Item", "-Recurse", "-Force"],
    decision = "forbidden",
    justification = "Recursive forced deletion is prohibited; remove only an explicitly verified target.",
    match = ["Remove-Item -Recurse -Force temp"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push is prohibited; use a normal push or ask the user to resolve history.",
    match = ["git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force-push is prohibited for this training repository.",
    match = ["git push --force-with-lease origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can discard uncommitted training work; inspect status and diff instead.",
    match = ["git reset --hard HEAD"],
)

# Material external or data-destructive operations require confirmation.
prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "prompt",
    justification = "Dropping the training database requires explicit user confirmation.",
    match = ["dotnet ef database drop -f"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes to a remote requires user confirmation.",
    match = ["git push", "git push origin main"],
    not_match = ["git status"],
)

# Routine project operations are allowed.
prefix_rule(
    pattern = ["dotnet", ["build", "test", "run"]],
    decision = "allow",
    justification = "Routine build, test, and local run commands.",
    match = ["dotnet build", "dotnet test --no-restore", "dotnet run --project src/OrderHub.Web"],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log"]],
    decision = "allow",
    justification = "Read-only Git inspection.",
    match = ["git status --short", "git diff", "git log -1"],
)

prefix_rule(
    pattern = ["git", ["add", "commit"]],
    decision = "allow",
    justification = "Routine local commit workflow after verification.",
    match = ["git add AGENTS.md", "git commit -m training"],
)
